  if started then return end

  started = true

  _G.__STOP_OTHER_SCRIPTS__ = true

  gui.Enabled = true

  for i = 5, 1, -1 do

   text.Text =

    "Script only work on Second Sea.\n" ..

    "We will tp you to Second Sea\n\n" ..

    "TP in "..i.."s"

   task.wait(1)

  end

  text.Text = "Teleporting..."

